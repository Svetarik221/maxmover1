# =============================================================
# MaxMover — пример конфигурации.
# Скопируйте этот файл в .env и заполните своими значениями.
#   cp .env.example .env
# =============================================================

# ---------- Telegram ----------
# Токен TG-бота. Получить у @BotFather → /newbot.
TG_BOT_TOKEN=
# Username бота (без @). Например: myposts_bot
TG_BOT_USERNAME=
# API_ID и API_HASH для Telethon. Получить на https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
# Телефон в международном формате (нужен только для одноразовой авторизации Telethon).
TG_PHONE=+71234567890

# ---------- MAX ----------
# Токен MAX-бота. Получить у @MasterBot в MAX → /newbot.
MAX_BOT_TOKEN=
# Username MAX-бота (без префикса). Например: id123456_1_bot
MAX_BOT_USERNAME=
# user_id вашего MAX-бота (число; нужен для исключения бота из списка админов канала).
# Узнать: после создания бота откройте его профиль в MAX → ссылка вида max.ru/id...
# Можно оставить 0 — тогда фильтр админов работает только по флагу is_bot.
MAX_BOT_USER_ID=0

# ---------- Служебная MAX-группа (relay) ----------
# Создайте в MAX обычную группу "Служебная — НЕ ТРОГАТЬ", добавьте туда вашего MAX-бота
# и ОБЯЗАТЕЛЬНО сделайте его АДМИНИСТРАТОРОМ с правом удалять сообщения.
# Без админских прав бот не сможет очищать чат, и накопленные служебные сообщения
# приведут к повторной публикации старых задач (см. troubleshooting в README).
# id группы — длинное отрицательное число, например: -73551701253532
RELAY_CHAT_ID=

# ---------- Администратор ----------
# TG user_id владельца бота (для алертов от health_check). Узнать: @userinfobot.
# 0 — алерты не отправляются.
ADMIN_TG_ID=0

# ---------- Database ----------
# Если запускаете через docker-compose — оставьте как есть.
DATABASE_URL=postgresql+asyncpg://maxmover:maxmover@db:5432/maxmover

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Open mode ----------
# True = все фичи доступны без оплаты (рекомендуется для self-hosted).
# False = классические тарифы Free/Старт/Про (требует ЮKassa ниже).
OPEN_MODE=true

# ---------- Webhook ----------
# Публичный HTTPS-адрес вашего сервера (для приёма webhook от MAX).
# Должен быть валидный SSL (Let's Encrypt). Без него MAX не будет слать события.
# Пример: https://yourbot.example.com
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/tg
MAX_WEBHOOK_PATH=/webhook/max

# Адрес мини-приложения (комментарии в MAX). Обычно совпадает с WEBHOOK_HOST.
WEBAPP_URL=

# ---------- ЮKassa (опционально, нужно только если OPEN_MODE=false) ----------
YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=

# ---------- Прокси (если ваш сервер в РФ — Telegram заблокирован) ----------
# SOCKS5 для aiogram (Bot API). Формат: socks5://user:pass@host:port
TG_API_PROXY=
# MTProto-прокси для Telethon (если используете отдельный DE-сервер вне РФ — оставьте пустым).
TG_MTPROTO_PROXY_HOST=
TG_MTPROTO_PROXY_PORT=443
TG_MTPROTO_PROXY_SECRET=

# ---------- DE-воркер (опционально, отдельный сервер с Telethon) ----------
# Если используете отдельный VPS вне РФ для Telethon (подробнее в README → "Архитектура"):
TELETHON_API_URL=
TELETHON_API_SECRET=

# ---------- Dev ----------
MAX_DEV_MODE=false
